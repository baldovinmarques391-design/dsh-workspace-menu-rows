{
  "name": "@local/dsh-workspace-menu-rows",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Keeps the workspace picker dropdown at four visible rows and scrolls the rest.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baldovinmarques391-design/dsh-workspace-menu-rows.git"
  }
}
